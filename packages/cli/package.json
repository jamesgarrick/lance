{
	"name": "@lance/cli",
	"version": "0.0.10",
	"type": "module",
	"private": false,
	"bin": {
		"lance": "./bin/run.js"
	},
	"files": [
		"bin",
		"dist",
		"package.json"
	],
	"scripts": {
		"build": "bun run --cwd ../compiler build && tsc -p tsconfig.build.json && bunx oclif manifest .",
		"release:pack": "bun run build && bunx oclif pack tarballs --root . --targets linux-x64,linux-arm64,darwin-x64,darwin-arm64,win32-x64"
	},
	"dependencies": {
		"@inquirer/prompts": "^7",
		"@lance/compiler": "workspace:*",
		"@oclif/core": "^4",
		"semver": "^7.7.3",
		"tar": "^7.5.2"
	},
	"devDependencies": {
		"@oclif/dev-cli": "^1.26.10",
		"@types/bun": "latest",
		"@types/semver": "^7.7.1",
		"typescript": "^6.0.3"
	},
	"oclif": {
		"bin": "lance",
		"dirname": "lance",
		"commands": "./dist/src/commands",
		"topicSeparator": ":",
		"theme": {
			"command": "green",
			"topic": "cyan",
			"commandSummary": "cyan",
			"sectionDescription": "white",
			"bin": "cyan",
			"dollarSign": "yellow"
		}
	}
}
