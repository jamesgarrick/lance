{
  "extends": "./.lance/tsconfig.paths.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,
    "noLib": true,
    "skipLibCheck": true,
    "types": [],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
  },
  "files": ["./globals.d.ts"],
  "include": ["src/**/*.ts", "lance.config.ts"],
  "exclude": ["lance_modules", "node_modules"],
}
