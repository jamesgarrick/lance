{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist",
		"target": "ESNext",
		"module": "ESNext",
		"rootDir": ".",
		"moduleResolution": "bundler",
		"paths": {
			"@lance/core": ["./index.ts"],
			"@lance/core/*": ["./*"]
		},
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "lance.config.ts"]
}
