{
	"name": "lance",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"playground"
	],
	"scripts": {
		"compile": "bun run --cwd packages/compiler compile",
		"typecheck": "bunx tsc --noEmit -p packages/compiler/tsconfig.json && bunx tsc --noEmit -p packages/core/tsconfig.json && bunx tsc --noEmit -p packages/cli/tsconfig.json && bunx tsc --noEmit -p packages/registry/tsconfig.json",
		"test": "bun run --cwd packages/compiler test",
		"compiler:compile": "bun run --cwd packages/compiler compile",
		"compiler:typecheck": "bunx tsc --noEmit -p packages/compiler/tsconfig.json",
		"core:typecheck": "bunx tsc --noEmit -p packages/core/tsconfig.json",
		"core:generate": "bun run --cwd packages/core generate:cfg",
		"cli:typecheck": "bunx tsc --noEmit -p packages/cli/tsconfig.json",
		"registry:dev": "bun run --cwd packages/registry dev",
		"registry:typecheck": "bunx tsc --noEmit -p packages/registry/tsconfig.json"
	},
	"dependencies": {
		"@types/bun": "^1.3.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13"
	}
}
