{
  "name": "lance-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "compile": "bun run --cwd packages/transpiler compile",
    "typecheck": "bun run transpiler:typecheck && bun run sqf-types:typecheck",
    "transpiler:compile": "bun run --cwd packages/transpiler compile",
    "transpiler:typecheck": "bun run --cwd packages/transpiler typecheck",
    "sqf-types:typecheck": "bun run --cwd packages/sqf-types typecheck",
    "sqf-types:generate": "bun run --cwd packages/sqf-types generate:cfg"
  },
  "dependencies": {
    "@types/bun": "^1.3.13"
  }
}
